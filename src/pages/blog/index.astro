---
import Base from '../../layouts/Base.astro';
import blogPosts from '../../data/blog-posts.json';

// Sort posts by publish date (newest first)
const sortedPosts = blogPosts.sort((a, b) => {
  return new Date(b.publish_date).getTime() - new Date(a.publish_date).getTime();
});
---

<Base
  title="Blog"
  description="Weekly insights on Panama, Bitcoin, remote business management, and flag theory for high earners building location optionality."
>
  <!-- Blog Header -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow">From the Blog</span>
      <h1>Weekly. Specific. No Filler.</h1>
      <p class="lead" style="margin-top:20px;">Every post is designed to answer a specific question or solve a real problem. No padding. No hypotheticals.</p>
    </div>
  </section>

  <hr class="divider">

  <!-- Blog Grid -->
  <section>
    <div class="container">
      <div class="grid-3" style="margin-top:32px;">
        {sortedPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} style="text-decoration: none;">
            <div class="blog-card">
              <div class="blog-img" style="background-image: url('{post.featured_image}'); background-size: cover; background-position: center;">
                {!post.featured_image && '[ IMAGE ]'}
              </div>
              <div class="blog-body">
                <span class="blog-cat">{post.category}</span>
                <div class="blog-title">{post.title}</div>
                <div class="blog-excerpt">{post.excerpt}</div>
              </div>
            </div>
          </a>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <div style="text-align: center; padding: 48px 0;">
          <p>No blog posts yet. Check back soon for the first weekly insight.</p>
        </div>
      )}
    </div>
  </section>
</Base>
