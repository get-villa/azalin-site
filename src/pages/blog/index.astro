---
import Base from '../../layouts/Base.astro';
import blogPosts from '../../data/blog-posts.json';

const BLOG_WEBHOOK = import.meta.env.PUBLIC_BLOG_WEBHOOK;

// Sort posts by publish date (newest first)
const sortedPosts = blogPosts.sort((a, b) => {
  return new Date(b.publish_date).getTime() - new Date(a.publish_date).getTime();
});
---

<Base
  title="Blog"
  description="Weekly insights on Panama, Bitcoin, remote business management, and flag theory for high earners building location optionality."
>
  <!-- Blog Header -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow">From the Blog</span>
      <h1>Weekly. Specific. No Filler.</h1>
      <p class="lead" style="margin-top:20px;">Every post is designed to answer a specific question or solve a real problem. No padding. No hypotheticals.</p>
    </div>
  </section>

  <hr class="divider">

  <!-- Blog Grid -->
  <section>
    <div class="container">
      <div class="grid-3" style="margin-top:32px;">
        {sortedPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} style="text-decoration: none;">
            <div class="blog-card">
              <div class="blog-img" style="background-image: url('{post.featured_image}'); background-size: cover; background-position: center;">
                {!post.featured_image && '[ IMAGE ]'}
              </div>
              <div class="blog-body">
                <span class="blog-cat">{post.category}</span>
                <div class="blog-title">{post.title}</div>
                <div class="blog-excerpt">{post.excerpt}</div>
              </div>
            </div>
          </a>
        ))}
      </div>

      {sortedPosts.length === 0 && (
        <div style="text-align: center; padding: 48px 0;">
          <p>No blog posts yet. Check back soon for the first weekly insight.</p>
        </div>
      )}
    </div>
  </section>

  <!-- Newsletter Subscribe -->
  <section class="bg2">
    <div class="container" style="max-width:520px; margin:0 auto; text-align:center;">
      <h2 style="margin-bottom:8px;">Get Every Post Delivered</h2>
      <p style="font-size:14px; margin-bottom:20px;">One email per week. No padding. Unsubscribe any time.</p>
      <form id="blog-index-form">
        <div class="form-group">
          <input type="email" name="email" placeholder="Your email address" required>
        </div>
        <button type="submit" class="btn-primary" style="width:100%; display:block; text-align:center; margin-top:8px;">Subscribe to the Blog</button>
      </form>
      <p class="form-note" id="blog-index-success" style="display:none; color:var(--gold);">✓ Check your inbox to confirm</p>
    </div>
  </section>

  <script is:inline define:vars={{BLOG_WEBHOOK}}>
    document.getElementById('blog-index-form').addEventListener('submit', async function(e) {
      e.preventDefault();
      const btn = this.querySelector('button');
      const form = e.target;

      btn.textContent = 'Subscribing…';
      btn.disabled = true;

      try {
        const response = await fetch(BLOG_WEBHOOK, {
          method: 'POST',
          body: JSON.stringify({
            email: form.email.value,
            subscribed_at: new Date().toISOString()
          })
        });

        if (!response.ok) {
          throw new Error(`HTTP ${response.status}: ${response.statusText}`);
        }

        form.style.display = 'none';
        document.getElementById('blog-index-success').style.display = 'block';
      } catch (err) {
        console.error('Subscription error:', err);
        btn.textContent = 'Try again';
        btn.disabled = false;
      }
    });
  </script>
</Base>
