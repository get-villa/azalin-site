---
import Base from '../layouts/Base.astro';
import blogPosts from '../data/blog-posts.json';
import founderPhoto from '../assets/founder-headshot.jpg';

// Get the 3 most recent blog posts
const recentPosts = blogPosts.slice(0, 3);

const BLOG_WEBHOOK = import.meta.env.PUBLIC_BLOG_WEBHOOK;
const BITCOIN_WEBHOOK = import.meta.env.PUBLIC_BITCOIN_MINI_COURSE_WEBHOOK;
const SCOUTING_WEBHOOK = import.meta.env.PUBLIC_SCOUTING_TRIP_WAITLIST_WEBHOOK;
const RETREAT_WEBHOOK = import.meta.env.PUBLIC_PANAMA_RETREAT_WAITLIST_WEBHOOK;
---

<style is:global>
  .waitlist-form {
    margin-top: 16px;
    display: flex;
    gap: 8px;
  }

  .waitlist-form input {
    flex: 1;
    background: transparent;
    border: 1px solid var(--border);
    padding: 10px 14px;
    border-radius: var(--radius);
    font-size: 14px;
    color: var(--text);
    font-family: 'Inter', sans-serif;
  }

  .waitlist-form input::placeholder {
    color: var(--text);
    opacity: 0.6;
  }

  .waitlist-form input:focus {
    outline: none;
    border-color: var(--gold);
  }

  .waitlist-form button {
    background: var(--gold);
    color: #0B1826;
    border: none;
    padding: 10px 20px;
    border-radius: var(--radius);
    font-weight: 700;
    font-size: 13px;
    cursor: pointer;
    transition: background 0.2s;
    white-space: nowrap;
  }

  .waitlist-form button:hover {
    background: var(--gold-lt);
  }

  .waitlist-success {
    color: var(--gold);
    font-size: 13px;
    margin-top: 8px;
  }
</style>

<Base
  title="Home"
  description="Canadian founders, owners, and executives earning $300K+ are sending $150K+ to CRA every year. Panama's territorial tax system is a legal, documented alternative. Done beside you by someone who has made the move."
>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Strategic Moves. Revealed.</span>
      <h1>You Built Something Real.<br>Canada Is Taking<br><em style="color:var(--gold)">Half of It Every Year.</em></h1>
      <p class="lead" style="margin-top:20px;">If your business or practice clears $300K, your annual tax bill is likely north of $150,000. That is not a fixed cost of doing business in Canada — it is the price of not knowing there is a legal alternative. Every year you stay is another six-figure cheque to CRA that does not have to be written.</p>
      <p style="margin-top:14px; font-size:16px; color:var(--muted);">If your accountant's best answer is "you're already doing the main things" — there is a documented path they almost certainly have not brought up. Panama's territorial tax system taxes only income earned within Panama. Your consulting fees, agency revenue, practice billings — 0%. I have walked this. I will walk it beside you.</p>
      <div class="btn-group">
        <a class="btn-primary" href="/report/">Get the Free Panama Report</a>
        <a class="btn-outline" href="/about/">Who I Am</a>
      </div>
      <div class="country-bar">
        <span class="country-pill">🇨🇦 Canadians</span>
        <span class="country-pill">Founders · Owners · Executives</span>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- Stats -->
  <section class="tight">
    <div class="container">
      <div class="stat-grid">
        <div class="stat"><span class="stat-number">0%</span><span class="stat-label">Panama tax on foreign-sourced income</span></div>
        <div class="stat"><span class="stat-number">$150K+</span><span class="stat-label">What a $300K earner sends to CRA annually — before Panama</span></div>
        <div class="stat"><span class="stat-number">3–6</span><span class="stat-label">Months to Panama permanent residency</span></div>
        <div class="stat"><span class="stat-number">50+</span><span class="stat-label">Nations whose citizens qualify for Panama's Friendly Nations Visa — Canada is one</span></div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- Who It's For -->
  <section>
    <div class="container">
      <span class="eyebrow">The Three Types</span>
      <h2>You Recognize Yourself Here?</h2>
      <div class="grid-3" style="margin-top:36px;">
        <div class="avatar-card">
          <div class="avatar-role">Financial Advisor · Canada</div>
          <div class="avatar-name">David Chen</div>
          <div class="avatar-location">Mississauga, Ontario</div>
          <div class="avatar-income">$420K take-home · 280 client households</div>
          <div class="avatar-quote">"I've spent 25 years telling clients that diversification is everything. It never occurred to me to diversify my tax jurisdiction."</div>
        </div>
        <div class="avatar-card">
          <div class="avatar-role">Digital Agency Owner · BC</div>
          <div class="avatar-name">Michael Reeves</div>
          <div class="avatar-location">Vancouver, British Columbia</div>
          <div class="avatar-income">$390K/year · 9 staff · location-independent ops</div>
          <div class="avatar-quote">"I have been meaning to look into this for three years. Every time I start researching I end up with seventeen browser tabs and no clearer on whether this is actually legal or just something people with eight figures do."</div>
        </div>
        <div class="avatar-card">
          <div class="avatar-role">Executive Consultant · Ontario</div>
          <div class="avatar-name">Sarah MacLeod</div>
          <div class="avatar-location">Toronto, Ontario</div>
          <div class="avatar-income">$510K revenue · solo practice · location-independent</div>
          <div class="avatar-quote">"I did the math last year. For every dollar I invoice, I am handing fifty-three cents to CRA. I have built something genuinely valuable and I would like to know there is a legal way to keep more of it."</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Three Paths -->
  <section>
    <div class="container">
      <span class="eyebrow">What Your Options Actually Are</span>
      <h2>Three Paths.<br>One That Works.</h2>
      <p style="max-width:640px; margin-bottom:36px; color:var(--muted);">The most common question: do I actually have to move? The honest answer depends on which outcome you want.</p>
      <div class="grid-3" style="margin-top:0;">
        <div class="card">
          <h3 style="margin-bottom:8px;">Snowbird</h3>
          <p style="font-size:13px; color:var(--muted); margin-bottom:12px;">Spend winters in Panama. Keep Canadian tax residency.</p>
          <p style="font-size:14px;">Enjoyable. No tax benefit. CRA's claim on your income is unchanged. Your accountant will still be giving you the same answer next year.</p>
        </div>
        <div class="card">
          <h3 style="margin-bottom:8px;">Second Residency</h3>
          <p style="font-size:13px; color:var(--muted); margin-bottom:12px;">Hold Panamanian residency without formally leaving Canada.</p>
          <p style="font-size:14px;">Genuine optionality. Asset protection through a Panama structure. Still no territorial tax benefit without formally breaking Canadian residency. A valid first step — not the full picture.</p>
        </div>
        <div class="card card-gold">
          <h3 style="margin-bottom:8px;">Full Relocation</h3>
          <p style="font-size:13px; color:var(--muted); margin-bottom:12px;">Break Canadian tax residency. Establish Panama as your primary residence.</p>
          <p style="font-size:14px;">This is the move that activates Panama's territorial tax system. Foreign-sourced income — your consulting fees, your agency revenue, your practice billings — is no longer subject to CRA. Legal. Documented. Article 694 of the Panamanian Fiscal Code.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Opportunity Cost -->
  <section>
    <div class="container">
      <span class="eyebrow">The Cost of Staying</span>
      <h2>The Money CRA Took This Year<br>Could Have Been Working For You.</h2>
      <p style="max-width:660px; margin-bottom:48px; color:var(--muted);">If a $300K Canadian earner had redirected $100,000 per year — the portion sent to CRA — into an S&amp;P 500 index fund starting in 2015, here is what that capital would be worth at the end of 2024.</p>
      <div class="grid-3" style="margin-bottom:48px;">
        <div class="card" style="text-align:center;">
          <div style="font-size:12px; color:var(--muted); margin-bottom:10px; text-transform:uppercase; letter-spacing:.07em;">Total Capital Sent to CRA</div>
          <div style="font-size:40px; font-weight:700; color:var(--text); line-height:1; font-family:'Playfair Display',serif;">$1,000,000</div>
          <div style="font-size:13px; color:var(--muted); margin-top:10px;">10 years × $100K/year</div>
        </div>
        <div class="card card-gold" style="text-align:center;">
          <div style="font-size:12px; color:var(--muted); margin-bottom:10px; text-transform:uppercase; letter-spacing:.07em;">What It Would Be Worth</div>
          <div style="font-size:40px; font-weight:700; color:var(--gold); line-height:1; font-family:'Playfair Display',serif;">$2,265,650</div>
          <div style="font-size:13px; color:var(--muted); margin-top:10px;">S&amp;P 500 total return, 2015–2024</div>
        </div>
        <div class="card" style="text-align:center;">
          <div style="font-size:12px; color:var(--muted); margin-bottom:10px; text-transform:uppercase; letter-spacing:.07em;">Compounding Gain Lost</div>
          <div style="font-size:40px; font-weight:700; color:var(--text); line-height:1; font-family:'Playfair Display',serif;">$1,265,650</div>
          <div style="font-size:13px; color:var(--muted); margin-top:10px;">Capital that never worked for you</div>
        </div>
      </div>
      <div style="margin-bottom:40px;">
        <div style="font-size:12px; color:var(--muted); margin-bottom:16px; text-transform:uppercase; letter-spacing:.07em;">$100K invested each year → value at end of 2024</div>
        <div style="display:flex; flex-direction:column; gap:10px;">
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2015</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:100%; height:100%; background:var(--gold); border-radius:3px; opacity:.85;"></div></div><span style="font-size:13px; color:var(--gold); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$342,820</span></div>
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2016</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:98.6%; height:100%; background:var(--gold); border-radius:3px; opacity:.85;"></div></div><span style="font-size:13px; color:var(--gold); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$338,150</span></div>
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2017</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:88.1%; height:100%; background:var(--gold); border-radius:3px; opacity:.85;"></div></div><span style="font-size:13px; color:var(--gold); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$301,990</span></div>
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2018</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:72.3%; height:100%; background:var(--gold); border-radius:3px; opacity:.85;"></div></div><span style="font-size:13px; color:var(--gold); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$247,820</span></div>
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2019</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:75.6%; height:100%; background:var(--gold); border-radius:3px; opacity:.85;"></div></div><span style="font-size:13px; color:var(--gold); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$259,180</span></div>
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2020</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:57.5%; height:100%; background:var(--gold); border-radius:3px; opacity:.85;"></div></div><span style="font-size:13px; color:var(--gold); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$197,030</span></div>
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2021</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:48.5%; height:100%; background:var(--gold); border-radius:3px; opacity:.85;"></div></div><span style="font-size:13px; color:var(--gold); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$166,410</span></div>
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2022</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:37.7%; height:100%; background:var(--gold); border-radius:3px; opacity:.55;"></div></div><span style="font-size:13px; color:var(--muted); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$129,340</span></div>
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2023</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:46.1%; height:100%; background:var(--gold); border-radius:3px; opacity:.85;"></div></div><span style="font-size:13px; color:var(--gold); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$157,890</span></div>
          <div style="display:flex; align-items:center; gap:12px;"><span style="font-size:13px; color:var(--muted); width:34px; flex-shrink:0;">2024</span><div style="flex:1; background:var(--bg3); border-radius:3px; height:22px;"><div style="width:36.5%; height:100%; background:var(--gold); border-radius:3px; opacity:.85;"></div></div><span style="font-size:13px; color:var(--gold); font-weight:600; width:82px; text-align:right; flex-shrink:0;">$125,020</span></div>
        </div>
      </div>
      <p style="max-width:660px; font-size:15px; line-height:1.7;">The cost of inaction is not $150,000 this year. Compounded across a decade, it is over <strong style="color:var(--gold);">$1.26 million in capital that did not work for you</strong> — on top of the $1 million already surrendered. Panama's territorial tax system is a legal, documented alternative. Every year you stay is another $100,000 that goes to CRA instead of your portfolio.</p>
      <p style="font-size:12px; color:var(--muted); margin-top:16px; opacity:.6;">Based on S&amp;P 500 total return index (dividends reinvested), January 2015–December 2024. Assumes $100,000 invested at the start of each calendar year. Figures are illustrative. Not financial advice. Past performance does not guarantee future results.</p>
      <div class="btn-group" style="margin-top:32px;">
        <a class="btn-primary" href="/lifestyle/">Run Your Numbers →</a>
      </div>
    </div>
  </section>

  <!-- What the Other Side Looks Like -->
  <section class="bg2">
    <div class="container">
      <span class="eyebrow">The Other Side</span>
      <h2 style="max-width:640px;">This Is What the Calendar Looks Like<br>After You Make the Move.</h2>
      <p style="max-width:620px; color:var(--muted); margin-bottom:48px; font-size:15px; line-height:1.7;">Same business. Same revenue. Different country. Panama's territorial tax system does not care what you earned — it cares where you earned it. Foreign-sourced income is zero-rated. The hours you recover are yours to keep.</p>

      <!-- Calendar visual -->
      <div class="cal-cols" style="max-width:760px; margin:0 auto 48px;">
        <div class="cal-card">
          <span class="cal-card-title">Canada — Now</span>
          <div class="cal-row"><span class="cal-day">Mon</span><div class="cal-track"><div class="cal-fill-full"></div></div></div>
          <div class="cal-row"><span class="cal-day">Tue</span><div class="cal-track"><div class="cal-fill-full"></div></div></div>
          <div class="cal-row"><span class="cal-day">Wed</span><div class="cal-track"><div class="cal-fill-full"></div></div></div>
          <div class="cal-row"><span class="cal-day">Thu</span><div class="cal-track"><div class="cal-fill-full"></div></div></div>
          <div class="cal-row"><span class="cal-day">Fri</span><div class="cal-track"><div class="cal-fill-full"></div></div></div>
          <div class="cal-times"><span>7am</span><span>7pm</span></div>
          <div class="cal-total">~55 hrs/week</div>
          <div class="cal-sub">Every day. Every week.</div>
        </div>
        <div class="cal-card cal-after">
          <span class="cal-card-title">Panama — Redesigned</span>
          <div class="cal-row"><span class="cal-day">Mon</span><div class="cal-track"></div></div>
          <div class="cal-row"><span class="cal-day">Tue</span><div class="cal-track"><div class="cal-fill-work"></div></div></div>
          <div class="cal-row"><span class="cal-day">Wed</span><div class="cal-track"><div class="cal-fill-work"></div></div></div>
          <div class="cal-row"><span class="cal-day">Thu</span><div class="cal-track"><div class="cal-fill-work"></div></div></div>
          <div class="cal-row"><span class="cal-day">Fri</span><div class="cal-track"></div></div>
          <div class="cal-times"><span>7am</span><span>7pm</span></div>
          <div class="cal-total">~12 hrs/week</div>
          <div class="cal-sub">Tue–Thu · 9am–noon · Deep work only</div>
        </div>
      </div>
      <div class="cal-legend" style="margin-bottom:56px;">
        <div class="cal-legend-item"><div class="cal-dot" style="background:rgba(122,155,181,.35);"></div>Occupied</div>
        <div class="cal-legend-item"><div class="cal-dot" style="background:var(--gold); opacity:.88;"></div>Deep work (Panama)</div>
        <div class="cal-legend-item"><div class="cal-dot" style="background:var(--bg3);"></div>Free</div>
      </div>

      <!-- Three contrast stat cards -->
      <div class="grid-3" style="margin-bottom:48px;">
        <div class="card" style="text-align:center;">
          <div style="font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.07em; margin-bottom:14px;">Tax Bill</div>
          <div style="font-size:13px; color:var(--muted); margin-bottom:8px; text-decoration:line-through;">$150,000+ to CRA</div>
          <div style="font-size:32px; font-weight:700; color:var(--gold); font-family:'Playfair Display',serif; line-height:1;">$0</div>
          <div style="font-size:12px; color:var(--muted); margin-top:8px;">Panama territorial tax — Article 694</div>
        </div>
        <div class="card card-gold" style="text-align:center;">
          <div style="font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.07em; margin-bottom:14px;">Your Hours</div>
          <div style="font-size:13px; color:var(--muted); margin-bottom:8px; text-decoration:line-through;">55 hrs/week</div>
          <div style="font-size:32px; font-weight:700; color:var(--gold); font-family:'Playfair Display',serif; line-height:1;">12 hrs</div>
          <div style="font-size:12px; color:var(--muted); margin-top:8px;">Tue–Thu · 9am–noon · Everything else is yours</div>
        </div>
        <div class="card" style="text-align:center;">
          <div style="font-size:11px; color:var(--muted); text-transform:uppercase; letter-spacing:.07em; margin-bottom:14px;">10-Year Gap</div>
          <div style="font-size:13px; color:var(--muted); margin-bottom:8px; text-decoration:line-through;">$1,500,000 to CRA</div>
          <div style="font-size:32px; font-weight:700; color:var(--gold); font-family:'Playfair Display',serif; line-height:1;">$2,698,000</div>
          <div style="font-size:12px; color:var(--muted); margin-top:8px;">Investable wealth · S&amp;P 500 DCA at 10.4%</div>
        </div>
      </div>

      <div class="btn-group">
        <a class="btn-primary" href="/lifestyle/">Run Your Numbers →</a>
      </div>
    </div>
  </section>

  <!-- Founder Teaser -->
  <section>
    <div class="container">
      <div class="grid-2" style="gap:56px; align-items:center;">
        <div>
          <span class="eyebrow">The Founder</span>
          <h2>I Did This Without the Resources You Already Have.</h2>
          <p style="margin-bottom:16px;">Eight years. Seven countries. A federally incorporated Canadian company managed from a desk in Antalya, Turkey. A remote business built from scratch, scaled from a $99 course to $5,000, while living abroad with feast-or-famine income and an unexpected child on the way.</p>
          <p style="margin-bottom:16px;">I have filed Canadian non-resident tax returns from three countries. Navigated four concurrent immigration applications across two embassies while living in a third. Watched the Turkish Lira collapse in real time. Borrowed against my Bitcoin rather than selling it.</p>
          <p>I am not a theorist. I am a person who has actually done the thing you are thinking about.</p>
          <div class="btn-group" style="margin-top:24px;"><a class="btn-outline" href="/about/">Read the Full Story</a></div>
        </div>
        <div style="border-radius:var(--radius); overflow:hidden; border:1px solid var(--border);">
          <img
            src={founderPhoto.src}
            alt="Joshua Allen — Founder of Azalin"
            style="width:100%; height:360px; object-fit:cover; object-position:center top; display:block;"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Four Offers -->
  <section id="offers">
    <div class="container">
      <span class="eyebrow">How We Work Together</span>
      <h2>Four Ways In.<br>One Direction.</h2>
      <div style="margin-top:36px;">
        <div class="offer-step">
          <div class="offer-num">1</div>
          <div>
            <span class="offer-price">FREE</span>
            <h3>The Panama Report + Blog</h3>
            <p>A clear, honest guide to Panama's territorial tax system, the Friendly Nations Visa, corporate setup, property ownership, and what life actually looks like for a western professional earning $300K or more. No fluff. No upsell disguised as education. Start here.</p>
            <div class="btn-group" style="margin-top:16px;"><a class="btn-primary" href="/report/">Download the Report</a></div>
          </div>
        </div>
        <div class="offer-step">
          <div class="offer-num">2</div>
          <div>
            <span class="offer-price">DONE-BESIDE-YOU</span>
            <h3>The Scouting Trip</h3>
            <p>You fly to Panama. I meet you there. Over several days, I walk you through the neighbourhoods, the banks, the legal process, and the realities of daily life at your income level. You leave with a clear picture of whether Panama is the next move. Optional: add the Friendly Nations Visa application and I sit beside you through the process itself.</p>
            <form class="waitlist-form" data-webhook="scouting">
              <input type="email" placeholder="your@email.com" required>
              <button type="submit">Join Waitlist</button>
              <div class="waitlist-success" style="display:none;">✓ You're on the list</div>
            </form>
          </div>
        </div>
        <div class="offer-step">
          <div class="offer-num">3</div>
          <div>
            <span class="offer-price">$197 · ONLINE</span>
            <h3>Bitcoin Mini-Course + Cold Storage</h3>
            <p>Self-custody is not optional for the wealthy. This is a practical guide to Bitcoin security, hardware wallets, and how to move your first coins into cold storage. Includes a Tangem card to get you started immediately. Perfect for professionals who want to understand what they are holding.</p>
            <form class="waitlist-form" data-webhook="bitcoin">
              <input type="email" placeholder="your@email.com" required>
              <button type="submit">Join Waitlist</button>
              <div class="waitlist-success" style="display:none;">✓ You're on the list</div>
            </form>
          </div>
        </div>
        <div class="offer-step">
          <div class="offer-num">4</div>
          <div>
            <span class="offer-price">BY APPLICATION</span>
            <h3>The Panama Executive Programme</h3>
            <p>A seven-day professional development intensive in Panama City. Remote business operations practice, Bitcoin literacy and cold storage implementation, executive wellness, and cultural immersion. Structured as a corporate professional development programme — qualifying participants may expense this against their business. You leave knowing exactly how your business runs without you in the room, and whether Panama is the next move. Limited seats.</p>
            <form class="waitlist-form" data-webhook="retreat">
              <input type="email" placeholder="your@email.com" required>
              <button type="submit">Join Waitlist</button>
              <div class="waitlist-success" style="display:none;">✓ You're on the list</div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Blog Teaser -->
  <section class="bg2">
    <div class="container">
      <span class="eyebrow">From the Blog</span>
      <h2>Insights on Panama, Bitcoin, and Remote Business.</h2>
      <div class="grid-3" style="margin-top:32px;">
        {recentPosts.map((post) => (
          <a href={`/blog/${post.slug}/`} style="text-decoration: none;">
            <div class="blog-card">
              {post.featured_image && (
                <img
                  src={post.featured_image}
                  alt={post.featured_image_alt}
                  style="height: 160px; width: 100%; object-fit: cover; display: block;"
                />
              )}
              {!post.featured_image && (
                <div class="blog-img">[ IMAGE ]</div>
              )}
              <div class="blog-body">
                <span class="blog-cat">{post.category}</span>
                <div class="blog-title">{post.title}</div>
                <div class="blog-excerpt">{post.excerpt}</div>
              </div>
            </div>
          </a>
        ))}
      </div>
      <!-- Newsletter -->
      <div style="max-width:520px; margin:48px auto 0; text-align:center;">
        <h3 style="margin-bottom:8px;">Get Every Post Delivered.</h3>
        <p style="font-size:14px; margin-bottom:20px;">One email per week. No padding. Unsubscribe any time.</p>
        <form id="blog-form">
          <div class="form-group">
            <input type="email" name="email" placeholder="Your email address" required>
          </div>
          <button type="submit" class="btn-primary" style="width:100%; display:block; text-align:center; margin-top:8px; cursor:pointer;">Subscribe to the Blog</button>
        </form>
        <p class="form-note" id="blog-success" style="display:none; color:var(--gold);">✓ Check your inbox to confirm</p>
      </div>

      <script is:inline define:vars={{BLOG_WEBHOOK}}>
        // BLOG_WEBHOOK is injected via define:vars

        document.getElementById('blog-form').addEventListener('submit', async function(e) {
          e.preventDefault();
          const btn = this.querySelector('button');
          const form = e.target;

          btn.textContent = 'Subscribing…';
          btn.disabled = true;

          try {
            const response = await fetch(BLOG_WEBHOOK, {
              method: 'POST',
              body: JSON.stringify({
                email: form.email.value,
                subscribed_at: new Date().toISOString()
              })
            });

            if (!response.ok) {
              throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            form.style.display = 'none';
            document.getElementById('blog-success').style.display = 'block';
          } catch (err) {
            console.error('Subscription error:', err);
            btn.textContent = 'Try again';
            btn.disabled = false;
          }
        });
      </script>

      <!-- Waitlist Forms Script -->
      <script is:inline define:vars={{BITCOIN_WEBHOOK, SCOUTING_WEBHOOK, RETREAT_WEBHOOK}}>
        const webhooks = {
          bitcoin: BITCOIN_WEBHOOK,
          scouting: SCOUTING_WEBHOOK,
          retreat: RETREAT_WEBHOOK
        };

        document.querySelectorAll('.waitlist-form').forEach(form => {
          form.addEventListener('submit', async function(e) {
            e.preventDefault();
            const btn = this.querySelector('button');
            const input = this.querySelector('input');
            const successMsg = this.querySelector('.waitlist-success');
            const webhookType = this.getAttribute('data-webhook');
            const webhook = webhooks[webhookType];

            btn.textContent = 'Joining…';
            btn.disabled = true;

            try {
              const response = await fetch(webhook, {
                method: 'POST',
                body: JSON.stringify({
                  email: input.value,
                  list_type: webhookType,
                  joined_at: new Date().toISOString()
                })
              });

              if (!response.ok) {
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
              }

              input.style.display = 'none';
              btn.style.display = 'none';
              successMsg.style.display = 'block';
            } catch (err) {
              console.error('Waitlist error:', err);
              btn.textContent = 'Try again';
              btn.disabled = false;
            }
          });
        });
      </script>
    </div>
  </section>
</Base>
