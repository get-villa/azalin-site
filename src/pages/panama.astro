    btn.setAttribute('aria-expanded', !isOpen);
    const label = btn.querySelector('span:first-child');
    label.textContent = isOpen ? 'Show 3 more neighbourhoods' : 'Show fewer neighbourhoods';
  }
</script>

</Base>
