---
import Base from '../layouts/Base.astro';
---

<style is:global>
  /* Bitcoin page styles */
  .btc-stat-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-top: 32px;
  }
  @media (min-width: 768px) {
    .btc-stat-grid { grid-template-columns: repeat(4, 1fr); }
  }

  .btc-stat-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    border-top: 3px solid var(--gold);
    text-align: center;
  }
  .btc-stat-number {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 700;
    color: var(--gold);
    display: block;
    margin-bottom: 4px;
  }
  .btc-stat-label {
    font-size: 12px;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    font-weight: 600;
    line-height: 1.4;
  }

  /* Supply comparison */
  .supply-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
  }
  .supply-card {
    padding: 28px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
  }
  .supply-card.bitcoin { background: var(--bg2); border-top: 4px solid var(--gold); }
  .supply-card.fiat { background: var(--bg); border-top: 4px solid var(--border); }
  .supply-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 12px;
  }
  .supply-label.bitcoin-label { color: var(--gold); }
  .supply-label.fiat-label { color: var(--muted); }
  .supply-number {
    font-family: 'Playfair Display', serif;
    font-size: 32px;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .supply-number.btc-num { color: var(--gold); }
  .supply-number.fiat-num { color: var(--muted); }

  /* iPhone table */
  .iphone-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-top: 24px;
  }
  .iphone-table th {
    text-align: left;
    padding: 10px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .iphone-table td {
    padding: 11px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
  }
  .iphone-table tr:last-child td { border-bottom: none; }
  .iphone-table tr:hover td { background: var(--bg2); }
  .iphone-table .btc-col { color: var(--gold); font-weight: 700; font-family: 'Playfair Display', serif; }
  .iphone-table .year-col { color: var(--muted); font-weight: 600; }
  @media (max-width: 767px) {
    .iphone-table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  }

  /* Sound money properties */
  .money-props {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    margin-top: 24px;
  }
  @media (min-width: 768px) {
    .money-props { grid-template-columns: repeat(3, 1fr); }
  }
  .money-prop {
    padding: 20px;
    border-right: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .money-prop:nth-child(2n) { border-right: none; }
  @media (min-width: 768px) {
    .money-prop:nth-child(3n) { border-right: none; }
    .money-prop:nth-child(2n) { border-right: 1px solid var(--border); }
    .money-prop:nth-last-child(-n+3) { border-bottom: none; }
  }
  .money-prop-name {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 4px;
  }
  .money-prop-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
  }

  /* Advocate cards */
  .advocate-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 14px;
    margin-top: 28px;
  }
  @media (min-width: 768px) {
    .advocate-grid { grid-template-columns: repeat(2, 1fr); }
  }
  .advocate-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 18px 20px;
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .advocate-role {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 2px;
  }
  .advocate-name {
    font-weight: 700;
    font-size: 15px;
    color: var(--text);
    margin-bottom: 4px;
  }
  .advocate-quote {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
    font-style: italic;
  }

  /* Nation state table */
  .nation-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-top: 24px;
  }
  .nation-table th {
    text-align: left;
    padding: 10px 14px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    border-bottom: 1px solid var(--border);
  }
  .nation-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    vertical-align: top;
  }
  .nation-table tr:last-child td { border-bottom: none; }
  .nation-entity { font-weight: 600; }
  .nation-type {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--gold);
  }
  @media (max-width: 767px) {
    .nation-table { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .supply-compare { grid-template-columns: 1fr; }
  }

  /* Protocol comparison */
  .protocol-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }
  .protocol-row:last-child { border-bottom: none; }
  .protocol-name {
    font-weight: 700;
    color: var(--text);
    width: 120px;
    flex-shrink: 0;
    font-family: 'Playfair Display', serif;
  }
  .protocol-desc { font-size: 14px; color: var(--muted); }

  /* Sats callout */
  .sats-explainer {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 28px;
    border-left: 4px solid var(--gold);
    margin-top: 28px;
  }
  .sats-math {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    color: var(--gold);
    margin: 12px 0;
  }

  /* Transfer explainer */
  .transfer-steps {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
    margin-top: 24px;
  }
  @media (min-width: 768px) {
    .transfer-steps { grid-template-columns: repeat(3, 1fr); }
  }
  .transfer-step {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 20px;
    text-align: center;
  }
  .transfer-step-num {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    color: var(--gold);
    margin-bottom: 8px;
  }
  .transfer-step-title {
    font-weight: 700;
    font-size: 14px;
    color: var(--text);
    margin-bottom: 6px;
  }
  .transfer-step-desc {
    font-size: 13px;
    color: var(--muted);
    line-height: 1.5;
  }
</style>

<Base
  title="Bitcoin — Sound Money for Serious Professionals"
  description="What Bitcoin actually is, how it works, why Panama doesn't tax it, and why the world's largest institutions and nation states are holding it. Framed for Canadian professionals earning $300K+."
>

  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <span class="eyebrow">Sound Money</span>
      <h1>Bitcoin.<br>What It Actually Is.</h1>
      <p class="lead" style="margin-top:16px; max-width:700px;">For someone earning $300K+ in Canada, the question is not whether Bitcoin is real. It is whether you have been measuring your wealth in the right currency — and whether the measuring stick itself is the problem.</p>
    </div>
  </section>

  <!-- Key stats -->
  <section class="tight">
    <div class="container">
      <div class="btc-stat-grid">
        <div class="btc-stat-card">
          <span class="btc-stat-number">21M</span>
          <span class="btc-stat-label">Maximum Bitcoin that will ever exist</span>
        </div>
        <div class="btc-stat-card">
          <span class="btc-stat-number">−99.99%</span>
          <span class="btc-stat-label">Drop in iPhone cost in BTC terms (162 BTC → 0.0072 BTC). In USD terms: +23%. Same phone. Different measuring stick.</span>
        </div>
        <div class="btc-stat-card">
          <span class="btc-stat-number">100M</span>
          <span class="btc-stat-label">Satoshis in one Bitcoin — divisible to 8 decimal places</span>
        </div>
        <div class="btc-stat-card">
          <span class="btc-stat-number">23+</span>
          <span class="btc-stat-label">Nation states with Bitcoin reserves or formal adoption strategies</span>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- The Measuring Stick -->
  <section>
    <div class="container">
      <div class="grid-2" style="gap:56px; align-items:start;">
        <div>
          <span class="eyebrow">The Measuring Stick Problem</span>
          <h2>You Are Pricing Everything in a Currency That Is Shrinking.</h2>
          <p style="margin-bottom:16px;">A $300K income feels like a lot. And it is — until you account for what the measuring stick does to the number. The Canadian dollar, like every fiat currency, is not a fixed unit. It is a claim on a pool of money that central banks can and do expand. When the pool expands, each unit buys less. That is not inflation — that is the mechanism.</p>
          <p style="margin-bottom:16px;">Between 2020 and 2022, Canada's money supply grew by more than 20% in 24 months. The price of your house, your groceries, and your professional services increased not because those things became more valuable — but because the measuring stick got shorter.</p>
          <p style="margin-bottom:16px;">Bitcoin operates on a different principle. Its supply is fixed by code, not by decree. When you price things in Bitcoin rather than Canadian dollars, a very different picture emerges: nearly everything has gotten cheaper, not more expensive, over the past decade.</p>
          <p>The iPhone table on this page illustrates that directly. An iPhone 4S cost 162 BTC in 2011. The iPhone 17 costs 0.0072 BTC in 2025. The iPhone hasn't gotten cheaper. The measuring stick hasn't shrunk. Bitcoin has gotten harder to produce and more sought after — so less of it buys the same phone.</p>
        </div>
        <div>
          <div class="pullquote">
            <p>"In a world where every currency can be printed, the asset that cannot be printed becomes the reference point."</p>
          </div>
          <div class="card" style="margin-top:20px;">
            <h3 style="margin-bottom:10px; font-size:15px;">The Advisor's Version</h3>
            <p style="font-size:13px; color:var(--muted);">You tell your clients to diversify across asset classes, geographies, and currencies. A Canadian portfolio fully denominated in Canadian dollars — real estate, equities, registered accounts — is concentrated in a single currency issued by a single government. That is not a diversified portfolio. That is a portfolio with a currency risk that most advisors never name.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- Fixed vs Infinite Supply -->
  <section class="bg2" id="supply">
    <div class="container">
      <span class="eyebrow">Fixed Supply vs. Infinite Supply</span>
      <h2>Why Prices Go Up in Fiat Terms.<br>Why They Go Down in Bitcoin Terms.</h2>
      <p style="max-width:640px; margin-bottom:0;">This is the single most important concept. Everything else follows from it.</p>
      <div class="supply-compare">
        <div class="supply-card bitcoin">
          <div class="supply-label bitcoin-label">Bitcoin</div>
          <div class="supply-number btc-num">21,000,000</div>
          <p style="font-size:14px; margin-bottom:12px;">The maximum number of Bitcoin that will ever exist is written into the protocol. It cannot be changed by any government, central bank, or company. As of 2025, approximately 19.7 million have been mined. The remaining 1.3 million will be released on a fixed, decreasing schedule until around 2140.</p>
          <p style="font-size:14px; margin-bottom:12px;"><strong>Energy-backed.</strong> Each Bitcoin is produced through real computational work — proof-of-work mining — that consumes electricity. You cannot create Bitcoin from nothing. The process has a physical cost floor.</p>
          <p style="font-size:14px; color:var(--gold); font-weight:600;">Supply is fixed. Demand has increased. Simple arithmetic.</p>
        </div>
        <div class="supply-card fiat">
          <div class="supply-label fiat-label">Fiat Currency (CAD/USD/GBP)</div>
          <div class="supply-number fiat-num">∞</div>
          <p style="font-size:14px; margin-bottom:12px;">The supply of fiat currency has no hard cap. Central banks can and do expand the money supply through bond purchases, reserve policy, and direct credit creation. Canada's M2 money supply grew from approximately $1.5T in 2015 to over $2.5T by 2023.</p>
          <p style="font-size:14px; margin-bottom:12px;"><strong>Decree-backed.</strong> Fiat currency derives its value from government mandate — you must accept it as legal tender. Its value is maintained by institutional trust and monetary policy, both of which are subject to political decisions.</p>
          <p style="font-size:14px; color:var(--muted); font-weight:600;">Supply is unlimited. Purchasing power dilutes over time by design.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- Sound Money Properties -->
  <section id="sound-money">
    <div class="container">
      <span class="eyebrow">Hard Money / Sound Money</span>
      <h2>What Makes Money Good at Being Money.</h2>
      <p style="max-width:680px; margin-bottom:0;">Economists have long identified a set of properties that distinguish good money from bad money. Gold held its position as the global reserve asset for centuries because it satisfies most of them. Bitcoin satisfies all of them — and improves on gold in the areas that matter most for a globally connected professional.</p>
      <div class="money-props">
        <div class="money-prop">
          <div class="money-prop-name">Scarce</div>
          <div class="money-prop-desc">Hard cap of 21M. Cannot be inflated away. Gold has this but is still mined; Bitcoin's issuance is mathematically fixed.</div>
        </div>
        <div class="money-prop">
          <div class="money-prop-name">Durable</div>
          <div class="money-prop-desc">A private key stored on a hardware device will hold Bitcoin indefinitely. No rust, no rot, no degradation.</div>
        </div>
        <div class="money-prop">
          <div class="money-prop-name">Divisible</div>
          <div class="money-prop-desc">1 Bitcoin = 100,000,000 satoshis. Divisible to 8 decimal places — better than gold, better than cash.</div>
        </div>
        <div class="money-prop">
          <div class="money-prop-name">Portable</div>
          <div class="money-prop-desc">$1 million in Bitcoin crosses a border in your head. $1 million in gold weighs 20 kilograms and triggers customs declarations.</div>
        </div>
        <div class="money-prop">
          <div class="money-prop-name">Verifiable</div>
          <div class="money-prop-desc">Anyone can verify any transaction, any balance, and the total supply on the public ledger — in real time, without asking anyone's permission.</div>
        </div>
        <div class="money-prop">
          <div class="money-prop-name">Censorship-resistant</div>
          <div class="money-prop-desc">No government, bank, or intermediary can freeze a Bitcoin wallet or block a transaction on the base protocol. The network processes valid transactions regardless of sender or receiver.</div>
        </div>
      </div>
      <div class="grid-2" style="gap:24px; margin-top:28px; align-items:start;">
        <div class="card card-gold">
          <h3 style="margin-bottom:10px; font-size:15px;">The Gold Comparison</h3>
          <p style="font-size:14px; margin-bottom:10px;">Gold has been humanity's default store of value for 5,000 years because it is scarce, durable, and requires energy to produce. Bitcoin inherits all three properties and adds portability, divisibility, and verifiability that gold cannot match.</p>
          <p style="font-size:14px; margin-bottom:10px;">Paul Tudor Jones — the billionaire hedge fund manager with $55B under management — described Bitcoin as "the fastest horse" in the race against inflation, and holds it alongside gold in his portfolio.</p>
          <p style="font-size:14px;">Stanley Druckenmiller — former chief strategist for George Soros and one of the most respected macro investors alive — stated he prefers Bitcoin to gold as a store of value for the next generation.</p>
        </div>
        <div class="card">
          <h3 style="margin-bottom:8px; font-size:15px;">What "Outside the System" Actually Means</h3>
          <p style="font-size:13px; color:var(--muted); margin-bottom:10px;">Bitcoin is not anti-government. It is not an ideology. It is a protocol — like TCP/IP or HTTP — that operates independently of any single institution. No central bank issues it. No government backs it. No company owns it.</p>
          <p style="font-size:13px; color:var(--muted);">This means its supply characteristics and transaction rules cannot be changed by political decisions. For a professional who has watched a single government determine their purchasing power, retirement viability, and tax burden — that independence is a feature, not a bug.</p>
        </div>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- iPhone Table -->
  <section class="bg2" id="iphone">
    <div class="container">
      <span class="eyebrow">The Measuring Stick in Action</span>
      <h2>What an iPhone Has Cost in Bitcoin<br>Every Year Since 2011.</h2>
      <p style="max-width:640px; margin-bottom:0;">The iPhone hasn't changed much in price. What has changed is how much Bitcoin you need to buy one. This is not an argument for buying iPhones with Bitcoin. It is a demonstration of what happens when you use a currency with a fixed supply as your unit of account. Data: CoinGecko, launch-day prices.</p>
      <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
        <table class="iphone-table">
          <thead>
            <tr>
              <th>Year</th>
              <th>iPhone Model</th>
              <th>Price (USD)</th>
              <th>BTC Cost</th>
              <th>BTC Price That Day</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="year-col">2011</td><td>iPhone 4S</td><td>$649</td>
              <td class="btc-col">162.25</td><td>$4.00</td>
            </tr>
            <tr>
              <td class="year-col">2012</td><td>iPhone 5</td><td>$649</td>
              <td class="btc-col">52.76</td><td>$12.30</td>
            </tr>
            <tr>
              <td class="year-col">2013</td><td>iPhone 5S</td><td>$649</td>
              <td class="btc-col">5.05</td><td>$128.57</td>
            </tr>
            <tr>
              <td class="year-col">2014</td><td>iPhone 6</td><td>$649</td>
              <td class="btc-col">1.65</td><td>$393.26</td>
            </tr>
            <tr>
              <td class="year-col">2015</td><td>iPhone 6S</td><td>$649</td>
              <td class="btc-col">2.76</td><td>$234.98</td>
            </tr>
            <tr>
              <td class="year-col">2016</td><td>iPhone 7</td><td>$649</td>
              <td class="btc-col">1.07</td><td>$606.55</td>
            </tr>
            <tr>
              <td class="year-col">2017</td><td>iPhone X</td><td>$999</td>
              <td class="btc-col">0.138</td><td>$7,234.74</td>
            </tr>
            <tr>
              <td class="year-col">2018</td><td>iPhone XS</td><td>$999</td>
              <td class="btc-col">0.154</td><td>$6,491.89</td>
            </tr>
            <tr>
              <td class="year-col">2019</td><td>iPhone 11</td><td>$699</td>
              <td class="btc-col">0.0682</td><td>$10,253.23</td>
            </tr>
            <tr>
              <td class="year-col">2020</td><td>iPhone 12</td><td>$829</td>
              <td class="btc-col">0.0510</td><td>$16,265.15</td>
            </tr>
            <tr>
              <td class="year-col">2021</td><td>iPhone 13</td><td>$799</td>
              <td class="btc-col">0.0178</td><td>$44,980.90</td>
            </tr>
            <tr>
              <td class="year-col">2022</td><td>iPhone 14</td><td>$799</td>
              <td class="btc-col">0.0424</td><td>$18,859.50</td>
            </tr>
            <tr>
              <td class="year-col">2023</td><td>iPhone 15</td><td>$799</td>
              <td class="btc-col">0.0309</td><td>$25,867.60</td>
            </tr>
            <tr>
              <td class="year-col">2024</td><td>iPhone 16</td><td>$799</td>
              <td class="btc-col">0.0140</td><td>$57,049.43</td>
            </tr>
            <tr style="background: var(--bg2);">
              <td class="year-col">2025</td><td>iPhone 17</td><td>$799</td>
              <td class="btc-col">0.0072</td><td>$111,033.00</td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="card card-gold" style="max-width:680px; margin-top:20px;">
        <p style="font-size:14px; margin-bottom:10px;">If you had purchased 5 Bitcoin in 2013 — enough to buy two iPhones at the time — those 5 BTC would today purchase approximately 694 iPhone 17s.</p>
        <p style="font-size:14px;">The same 5 BTC in 2013 would have cost approximately $640 USD. At 2025 prices, those 5 BTC are worth approximately CA$775,000. Not because iPhones became more affordable. Because you changed the measuring stick.</p>
      </div>
    </div>
  </section>

  <hr class="divider">

  <!-- You Own the Asset -->
  <section id="ownership">
    <div class="container">
      <div style="max-width:720px;">
        <span class="eyebrow">Self-Custody vs. an IOU</span>
        <h2>Your Bank Account Is Not an Asset.<br>It Is a Claim on One.</h2>
        <p style="margin-bottom:16px;">When you deposit $500,000 in a bank, you do not own $500,000. You own an unsecured claim against a financial institution — a legal promise that, under normal conditions, will be honoured when you ask for it back. The bank loans your money out, invests it, and manages its own solvency. Your deposit is their liability.</p>
        <p style="margin-bottom:16px;">Canada Deposit Insurance Corporation (CDIC) insures up to $100,000 per depositor, per category. A $300K+ earner with liquidity concentrated in a single institution has meaningful uninsured exposure. This is not a fringe concern — it is the plain structure of the banking system.</p>
        <p style="margin-bottom:16px;">Bitcoin held in cold storage — on a hardware device you control, with a private key only you hold — is not a claim. It is the asset itself. There is no counterparty. There is no institution between you and the asset. No one can freeze it, lend it out, or deny you access to it.</p>
        <p style="margin-bottom:24px;">This is the most important distinction in Bitcoin ownership. Holding Bitcoin on an exchange is the equivalent of a bank deposit — you hold a claim, not the asset. Cold storage is ownership.</p>
        <div class="card">
          <h3 style="margin-bottom:14px; font-size:15px;">Bank Deposit vs. Bitcoin Cold Storage</h3>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; font-size:13px;">
            <div>
              <div style="font-weight:700; color:var(--muted); text-transform:uppercase; font-size:11px; letter-spacing:1px; margin-bottom:8px;">Bank Deposit</div>
              <p style="color:var(--muted); margin-bottom:6px;">You hold: a legal claim</p>
              <p style="color:var(--muted); margin-bottom:6px;">Counterparty: your bank</p>
              <p style="color:var(--muted); margin-bottom:6px;">CDIC insured: up to $100K</p>
              <p style="color:var(--muted); margin-bottom:6px;">Can be frozen: yes</p>
              <p style="color:var(--muted);">Lent out by bank: yes</p>
            </div>
            <div>
              <div style="font-weight:700; color:var(--gold); text-transform:uppercase; font-size:11px; letter-spacing:1px; margin-bottom:8px;">Bitcoin Cold Storage</div>
              <p style="color:var(--text); margin-bottom:6px;">You hold: the asset itself</p>
              <p style="color:var(--text); margin-bottom:6px;">Counterparty: none</p>
              <p style="color:var(--text); margin-bottom:6px;">Protection: cryptographic key</p>
              <p style="color:var(--text); margin-bottom:6px;">Can be frozen: no</p>
